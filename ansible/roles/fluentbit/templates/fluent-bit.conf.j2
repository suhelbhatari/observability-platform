[SERVICE]
    Flush        5
    Daemon       Off
    Log_Level    info
    Parsers_File parsers.conf
    HTTP_Server  On
    HTTP_Listen  0.0.0.0
    HTTP_Port    2020

[INPUT]
    Name             tail
    Tag              host.*
    Path             /var/log/syslog,/var/log/auth.log
    Path_Key         source_file
    Refresh_Interval 5
    Mem_Buf_Limit    64MB

{% for path in log_paths | default(['/var/log/app/*.log']) %}
[INPUT]
    Name             tail
    Tag              app.{{ inventory_hostname }}
    Path             {{ path }}
    Parser           app_json
    Refresh_Interval 5
    Mem_Buf_Limit    128MB
    Skip_Long_Lines  On
{% endfor %}

[FILTER]
    Name    modify
    Match   *
    Add     host {{ inventory_hostname }}
    Add     environment {{ environment | default('prod') }}
    Add     region {{ region | default('us-east-1') }}

# Ship to the local OTel Collector agent, which forwards to the central
# gateway (batching, retry, backpressure handled there) rather than to
# ClickHouse directly — keeps every agent config identical regardless of
# where logs ultimately land.
[OUTPUT]
    Name        opentelemetry
    Match       *
    Host        127.0.0.1
    Port        4318
    Logs_uri    /v1/logs
    Log_response_payload True
    Tls         Off
